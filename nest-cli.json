//
//  nest-cli.json
{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      { "include": "templates/**/*", "outDir": "dist/templates" },
      { "include": "surveys/templates/**/*", "outDir": "dist/surveys/templates" }
    ]
  }
}
