generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String     @id @default(cuid())
  type      OrgType
  name      String
  inn       String?    @unique
  contacts  Json?
  status    OrgStatus  @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  eventLogs EventLog[] @relation("EventLogOrganization")
  users     User[]
}

model User {
  id                 String        @id @default(cuid())
  email              String        @unique
  password           String
  name               String?
  role               UserRole      @default(USER)
  orgId              String?
  mfaEnabled         Boolean       @default(false)
  status             UserStatus    @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  eventLogs          EventLog[]    @relation("EventLogActor")
  surveyLinksCreated SurveyLink[]  @relation("SurveyLinkCreator")
  organization       Organization? @relation(fields: [orgId], references: [id])

  @@index([role])
  @@index([orgId])
}

model Insured {
  id              String           @id @default(cuid())
  name            String
  inn             String           @unique
  industry        String?
  size            String?
  contacts        Json?
  status          InsuredStatus    @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assertions      Assertion[]
  assets          Asset[]
  auditArtifacts  AuditArtifact[]
  contradictions  Contradiction[]
  eventLogs       EventLog[]       @relation("EventLogInsured")
  findings        Finding[]
  scores          Score[]
  surveyLinks     SurveyLink[]
  surveyResponses SurveyResponse[]

  @@index([industry])
  @@index([status])
}

model Survey {
  id              String           @id
  version         String
  title           String
  schema          Json
  status          SurveyStatus     @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  surveyLinks     SurveyLink[]
  surveyResponses SurveyResponse[]

  @@index([version])
}

model SurveyLink {
  id         String           @id
  surveyId   String
  insuredId  String
  token      String           @unique
  status     LinkStatus       @default(ISSUED)
  expiresAt  DateTime?
  createdBy  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  assertions Assertion[]      @relation("AssertionLink")
  creator    User?            @relation("SurveyLinkCreator", fields: [createdBy], references: [id])
  insured    Insured          @relation(fields: [insuredId], references: [id])
  survey     Survey           @relation(fields: [surveyId], references: [id])
  responses  SurveyResponse[]

  @@index([insuredId, status])
  @@index([expiresAt])
}

model SurveyResponse {
  id                  String         @id
  surveyId            String
  insuredId           String
  linkId              String
  respondentMeta      Json?
  answers             Json
  completenessPercent Decimal?
  submittedAt         DateTime?
  status              ResponseStatus @default(IN_PROGRESS)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  insured             Insured        @relation(fields: [insuredId], references: [id])
  link                SurveyLink     @relation(fields: [linkId], references: [id])
  survey              Survey         @relation(fields: [surveyId], references: [id])

  @@index([insuredId, submittedAt])
}

model Asset {
  id           String      @id @default(cuid())
  insuredId    String
  type         AssetType
  identifier   String
  source       AssetSource @default(SEED)
  discoveredAt DateTime?
  lastSeenAt   DateTime?
  status       AssetStatus @default(ACTIVE)
  meta         Json?
  insured      Insured     @relation(fields: [insuredId], references: [id])
  findings     Finding[]

  @@index([insuredId, type])
  @@index([identifier])
  @@index([status])
}

model Finding {
  id              String          @id @default(cuid())
  insuredId       String
  assetId         String?
  category        FindingCategory
  severity        FindingSeverity
  cveId           String?
  title           String
  description     String?
  evidence        Json?
  firstFoundAt    DateTime?
  lastConfirmedAt DateTime?
  status          FindingStatus   @default(OPEN)
  contradictions  Contradiction[]
  asset           Asset?          @relation(fields: [assetId], references: [id])
  insured         Insured         @relation(fields: [insuredId], references: [id])

  @@index([insuredId, severity])
  @@index([assetId])
  @@index([status])
  @@index([cveId])
}

model AuditArtifact {
  id         String       @id @default(cuid())
  insuredId  String
  type       ArtifactType
  label      String
  storageUrl String?
  hashSha256 String?
  issuedAt   DateTime?
  verified   Boolean      @default(false)
  meta       Json?
  createdAt  DateTime     @default(now())
  assertions Assertion[]  @relation("AssertionArtifact")
  insured    Insured      @relation(fields: [insuredId], references: [id])

  @@index([insuredId, type])
  @@index([verified])
}

model Assertion {
  id             String          @id @default(cuid())
  insuredId      String
  source         AssertionSource
  key            String
  value          Json?
  declaredAt     DateTime?
  linkId         String?
  artifactId     String?
  status         AssertionStatus @default(DECLARED)
  artifact       AuditArtifact?  @relation("AssertionArtifact", fields: [artifactId], references: [id])
  insured        Insured         @relation(fields: [insuredId], references: [id])
  link           SurveyLink?     @relation("AssertionLink", fields: [linkId], references: [id])
  contradictions Contradiction[]

  @@index([insuredId, key])
  @@index([status])
}

model Contradiction {
  id          String                @id @default(cuid())
  insuredId   String
  assertionId String
  findingId   String?
  severity    ContradictionSeverity
  ruleCode    String
  details     Json?
  createdAt   DateTime              @default(now())
  resolvedAt  DateTime?
  assertion   Assertion             @relation(fields: [assertionId], references: [id])
  finding     Finding?              @relation(fields: [findingId], references: [id])
  insured     Insured               @relation(fields: [insuredId], references: [id])

  @@index([insuredId, severity])
  @@index([assertionId])
  @@index([findingId])
}

model Score {
  id           String           @id @default(cuid())
  insuredId    String
  modelVersion String
  totalScore   Decimal
  band         ScoreBand
  rationale    Json?
  calculatedAt DateTime         @default(now())
  validUntil   DateTime?
  insured      Insured          @relation(fields: [insuredId], references: [id])
  components   ScoreComponent[]

  @@index([insuredId, calculatedAt])
  @@index([band])
}

model ScoreComponent {
  id        String             @id @default(cuid())
  scoreId   String
  component ScoreComponentType
  weight    Decimal
  value     Decimal
  details   Json?
  score     Score              @relation(fields: [scoreId], references: [id])

  @@index([scoreId, component])
}

model EventLog {
  id           String        @id @default(cuid())
  actorUserId  String?
  orgId        String?
  insuredId    String?
  type         EventType
  payload      Json?
  createdAt    DateTime      @default(now())
  actor        User?         @relation("EventLogActor", fields: [actorUserId], references: [id])
  insured      Insured?      @relation("EventLogInsured", fields: [insuredId], references: [id])
  organization Organization? @relation("EventLogOrganization", fields: [orgId], references: [id])

  @@index([type, createdAt])
  @@index([insuredId])
}

model Notification {
  id            String        @id @default(cuid())
  recipientType RecipientType
  recipientId   String
  channel       NotifyChannel
  templateCode  String
  status        NotifyStatus  @default(QUEUED)
  scheduledAt   DateTime?
  sentAt        DateTime?
  meta          Json?

  @@index([status])
  @@index([recipientType, recipientId])
}

/// *
///  * Пользовательские роли и организации
enum UserRole {
  ADMIN
  INSURER
  BROKER
  ANALYST
  USER
}

enum OrgType {
  INSURER
  BROKER
  PLATFORM
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  LOCKED
}

/// *
///  * Страхователи
enum InsuredStatus {
  ACTIVE
  INACTIVE
  TEST
}

/// *
///  * Опросы и ответы
enum SurveyStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum LinkStatus {
  ISSUED
  ACTIVE
  EXPIRED
  DEACTIVATED
  COMPLETED
}

enum ResponseStatus {
  IN_PROGRESS
  SUBMITTED
  VALIDATED
}

/// *
///  * Активы и находки (OSINT/ASM)
enum AssetType {
  DOMAIN
  HOST
  IP
  REPO
  BUCKET
}

enum AssetSource {
  SEED
  DISCOVERY
  MANUAL
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  UNCONFIRMED
}

enum FindingCategory {
  VULN
  MISCONFIG
  EXPOSURE
  LEAK
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FindingStatus {
  OPEN
  CONFIRMED
  MITIGATED
  CLOSED
  FALSE_POSITIVE
}

/// *
///  * Артефакты аудита
enum ArtifactType {
  POLICY
  LOG
  REPORT
  ATTESTATION
}

/// *
///  * Сопоставление и противоречия
enum AssertionSource {
  SURVEY
  AUDIT
  MANUAL
}

enum AssertionStatus {
  DECLARED
  VALIDATED
  CONTRADICTED
  EXPIRED
}

enum ContradictionSeverity {
  MINOR
  MAJOR
  CRITICAL
}

/// *
///  * Рейтинг
enum ScoreBand {
  A
  B
  C
  D
  E
}

enum ScoreComponentType {
  SURVEY
  OSINT
  AUDIT
  CONTRADICTIONS
  SIZE_ADJUSTMENT
}

/// *
///  * Логи и уведомления
enum EventType {
  LINK_CREATE
  SURVEY_SUBMIT
  SCAN_RUN
  SCORE_RECALC
  EXPORT
}

enum RecipientType {
  INSURED
  USER
  ORG
}

enum NotifyChannel {
  EMAIL
  WEBHOOK
}

enum NotifyStatus {
  QUEUED
  SENT
  FAILED
}
